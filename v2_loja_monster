<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monster Energy Store - Versão Web Oficial</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #050811;
        }
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: #10b981;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        /* Tema claro: fundo branco, cartões suaves e texto escuro */
        body, body.bg-slate-950 {
            background: #ffffff !important;
            color: #172033 !important;
        }
        header.bg-slate-900\/90,
        footer.bg-slate-900 {
            background: rgba(255, 255, 255, 0.96) !important;
            border-color: #e2e8f0 !important;
            color: #475569 !important;
        }
        [class*="bg-slate-950"], [class*="bg-slate-900"],
        [class*="bg-slate-800"], [class*="bg-slate-700"] {
            background-color: #f8fafc !important;
        }
        [class*="border-slate-800"], [class*="border-slate-700"] {
            border-color: #e2e8f0 !important;
        }
        [class*="text-white"] {
            color: #172033 !important;
        }
        [class*="text-slate-100"], [class*="text-slate-200"],
        [class*="text-slate-300"], [class*="text-slate-400"] {
            color: #64748b !important;
        }
        /* Mantém contraste no banner principal e nos botões verdes */
        .bg-gradient-to-r.from-emerald-900,
        .bg-gradient-to-r.from-emerald-900 * {
            color: #ffffff !important;
        }
        button.bg-emerald-500, button.bg-emerald-600,
        button[class*="bg-emerald-500"] {
            color: #052e24 !important;
        }
        [class*="shadow-xl"], [class*="shadow-2xl"] { box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06) !important; }
        html { scroll-behavior: smooth; }
        button, a, input { -webkit-tap-highlight-color: transparent; }
        #main-container { animation: storeEnter .28s ease both; }
        @keyframes storeEnter { from { opacity: .65; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
        #main-container .group:hover { transform: translateY(-3px); }
        #main-container .group { transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease; }
        #main-container .group:hover { box-shadow: 0 16px 35px rgba(15,23,42,.09); }
        header { box-shadow: 0 4px 24px rgba(15,23,42,.04) !important; }
        .monster-login-panel { background: radial-gradient(circle at 80% 15%, rgba(16,185,129,.22), transparent 35%), linear-gradient(145deg, #07130f, #0f172a 65%, #07130f) !important; }
        .monster-login-panel, .monster-login-panel * { color: inherit; }
        .monster-login-panel .text-emerald-400 { color: #34d399 !important; }
        .monster-login-panel .text-slate-300 { color: #cbd5e1 !important; }
        .monster-login-panel .text-slate-400 { color: #94a3b8 !important; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 antialiased min-h-screen flex flex-col selection:bg-emerald-500 selection:text-white">

    <header class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 shadow-xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="mudarAba('home')">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-emerald-600 to-emerald-400 flex items-center justify-center shadow-lg shadow-emerald-500/30 text-white text-xl font-black">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <div>
                    <h1 class="text-lg font-black tracking-wider text-white">MONSTER <span class="text-emerald-500">STORE</span></h1>
                    <p class="text-[10px] text-slate-400 font-semibold uppercase tracking-widest">Official Energy Hub</p>
                </div>
            </div>

            <nav class="hidden md:flex items-center space-x-8">
                <button onclick="mudarAba('home')" id="web-nav-home" class="text-sm font-bold text-emerald-400 transition hover:text-emerald-300 flex items-center space-x-2">
                    <i class="fa-solid fa-house"></i><span>Início</span>
                </button>
                <button onclick="mudarAba('catalogo')" id="web-nav-catalogo" class="text-sm font-medium text-slate-400 transition hover:text-white flex items-center space-x-2">
                    <i class="fa-solid fa-bolt"></i><span>Catálogo</span>
                </button>
                <button onclick="mudarAba('perfil')" id="web-nav-perfil" class="text-sm font-medium text-slate-400 transition hover:text-white flex items-center space-x-2">
                    <i class="fa-solid fa-user"></i><span>Meu Perfil</span>
                </button>
                <button onclick="mudarAba('login')" id="web-nav-login" class="text-sm font-bold text-slate-500 transition hover:text-emerald-600 flex items-center space-x-2">
                    <i class="fa-solid fa-right-to-bracket"></i><span id="login-nav-label">Entrar</span>
                </button>
            </nav>

            <div class="flex items-center space-x-4">
                <button onclick="mudarAba('carrinho')" class="relative bg-slate-800 hover:bg-slate-700 text-slate-200 px-5 py-2.5 rounded-2xl font-bold text-xs flex items-center space-x-2 border border-slate-700 transition shadow-md">
                    <i class="fa-solid fa-bag-shopping text-emerald-400 text-sm"></i>
                    <span>Carrinho</span>
                    <span id="cart-badge" class="absolute -top-1.5 -right-1.5 bg-emerald-500 text-slate-950 text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center hidden shadow-md">0</span>
                </button>
                
                <div class="hidden sm:flex items-center space-x-3 pl-3 border-l border-slate-800">
                    <div class="w-10 h-10 rounded-full bg-slate-800 overflow-hidden border-2 border-emerald-500 shadow-sm flex items-center justify-center text-emerald-400 font-bold">
                        G
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8" id="main-container">
        <!-- Conteúdo dinâmico -->
    </main>

    <footer class="bg-slate-900 border-t border-slate-800 py-10 mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center text-slate-400 text-xs space-y-4 md:space-y-0">
            <div class="flex items-center space-x-2">
                <i class="fa-solid fa-bolt text-emerald-500"></i>
                <span class="font-bold text-white">Monster Energy Store © 2026. Todos os direitos reservados.</span>
            </div>
            <div class="flex space-x-6">
                <a href="#" class="hover:text-emerald-400 transition">Termos de Uso</a>
                <a href="#" class="hover:text-emerald-400 transition">Política de Privacidade</a>
                <a href="#" class="hover:text-emerald-400 transition">Atendimento</a>
            </div>
        </div>
    </footer>

    <script>
        // Gerador de lata em SVG de alta qualidade para garantir renderização perfeita e sem falhas
        function gerarLataSVG(tipo) {
            let corBase = "#111827";
            let corGarra = "#10b981";
            let textoSabor = "ENERGY";
            let corTopo = "#374151";

            if (tipo === 'green') {
                corBase = "#0a0f0d";
                corGarra = "#10b981";
                textoSabor = "ENERGY";
            } else if (tipo === 'rosa') {
                corBase = "#831843";
                corGarra = "#f472b6";
                textoSabor = "ULTRA ROSA";
            } else if (tipo === 'mango') {
                corBase = "#0369a1";
                corGarra = "#fbbf24";
                textoSabor = "MANGO LOCO";
            } else if (tipo === 'sunrise') {
                corBase = "#7c2d12"; corGarra = "#fb923c"; textoSabor = "ULTRA SUNRISE";
            } else if (tipo === 'white') {
                corBase = "#e5e7eb"; corGarra = "#111827"; textoSabor = "ULTRA WHITE";
            } else if (tipo === 'blue') {
                corBase = "#1d4ed8"; corGarra = "#93c5fd"; textoSabor = "ULTRA BLUE";
            } else if (tipo === 'peach') {
                corBase = "#c2410c"; corGarra = "#fdba74"; textoSabor = "ULTRA PEACHY";
            } else if (tipo === 'watermelon') {
                corBase = "#be123c"; corGarra = "#4ade80"; textoSabor = "ULTRA ROSÁ";
            } else if (tipo === 'pipeline') {
                corBase = "#7e22ce"; corGarra = "#67e8f9"; textoSabor = "PIPELINE PUNCH";
            } else if (tipo === 'ultravio') {
                corBase = "#6d28d9"; corGarra = "#c4b5fd"; textoSabor = "ULTRA VIOLET";
            } else if (tipo === 'fiesta') {
                corBase = "#be185d"; corGarra = "#fde047"; textoSabor = "FIESTA MANGO";
            } else if (tipo === 'lewis') {
                corBase = "#14532d"; corGarra = "#facc15"; textoSabor = "LEWIS HAMILTON";
            }

            return `
                <svg viewBox="0 0 160 220" class="h-44 w-full drop-shadow-2xl" xmlns="http://www.w3.org/2000/svg">
                    <!-- Corpo da Lata -->
                    <rect x="35" y="25" width="90" height="175" rx="14" fill="${corBase}" stroke="#334155" stroke-width="2"/>
                    <!-- Topo Metálico -->
                    <path d="M 49 25 C 49 18, 111 18, 111 25 Z" fill="#94a3b8"/>
                    <ellipse cx="80" cy="25" rx="31" ry="6" fill="#cbd5e1"/>
                    <circle cx="80" cy="25" r="10" fill="#64748b"/>
                    <!-- Base Metálica -->
                    <path d="M 49 200 C 49 207, 111 207, 111 200 Z" fill="#94a3b8"/>
                    <!-- Garra Monster Estilizada -->
                    <path d="M 62 70 Q 72 90 68 120 Q 80 95 86 130 Q 92 95 98 120 Q 94 90 104 70 Z" fill="${corGarra}" opacity="0.95"/>
                    <!-- Texto da Marca -->
                    <text x="80" y="152" font-family="Inter, sans-serif" font-size="11" font-weight="900" fill="#ffffff" text-anchor="middle" letter-spacing="1">MØNSTER</text>
                    <text x="80" y="166" font-family="Inter, sans-serif" font-size="7" font-weight="800" fill="${corGarra}" text-anchor="middle" letter-spacing="2">${textoSabor}</text>
                </svg>
            `;
        }

        const catalogo = [
            { 
                id: 1, 
                nome: "Monster Energy Green", 
                sabor: "Tradicional - 473ml", 
                categoria: "Original", 
                preco: 10.49, 
                imagem: "data:image/png;base64,",
                badgeBg: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
            },
            { 
                id: 2, 
                nome: "Monster Ultra Rosa", 
                sabor: "Floral & Citrus Zero - 473ml", 
                categoria: "Ultra", 
                preco: 10.99, 
                imagem: "data:image/png;base64,",
                badgeBg: "bg-pink-500/10 text-pink-400 border-pink-500/20"
            },
            { 
                id: 3, 
                nome: "Monster Mango Loco", 
                sabor: "Manga com Suco - 473ml", 
                categoria: "Juice", 
                preco: 12.49, 
                imagem: "data:image/png;base64,",
                badgeBg: "bg-cyan-500/10 text-cyan-400 border-cyan-500/20"
            },
            { 
                id: 4, 
                nome: "Monster Ultra Sunrise", 
                sabor: "Laranja & Citrus Zero - 473ml", 
                categoria: "Ultra", 
                preco: 10.99, 
                imagem: "data:image/png;base64,",
                badgeBg: "bg-orange-500/10 text-orange-400 border-orange-500/20", tipoLata: "sunrise"
            },
            { id: 5, nome: "Monster Ultra White", sabor: "Cítrico leve Zero Açúcar - 473ml", categoria: "Ultra", preco: 10.99, imagem: null, tipoLata: "white", badgeBg: "bg-slate-200/70 text-slate-700 border-slate-300" },
            { id: 6, nome: "Monster Ultra Blue", sabor: "Frutas silvestres Zero - 473ml", categoria: "Ultra", preco: 10.99, imagem: null, tipoLata: "blue", badgeBg: "bg-blue-500/10 text-blue-600 border-blue-500/20" },
            { id: 7, nome: "Monster Ultra Peachy Keen", sabor: "Pêssego Zero Açúcar - 473ml", categoria: "Ultra", preco: 11.49, imagem: null, tipoLata: "peach", badgeBg: "bg-orange-500/10 text-orange-500 border-orange-500/20" },
            { id: 8, nome: "Monster Ultra Watermelon", sabor: "Melancia Zero Açúcar - 473ml", categoria: "Ultra", preco: 11.49, imagem: null, tipoLata: "watermelon", badgeBg: "bg-rose-500/10 text-rose-500 border-rose-500/20" },
            { id: 9, nome: "Monster Pipeline Punch", sabor: "Maracujá, laranja e goiaba - 473ml", categoria: "Juice", preco: 12.49, imagem: null, tipoLata: "pipeline", badgeBg: "bg-purple-500/10 text-purple-600 border-purple-500/20" },
            { id: 10, nome: "Monster Ultra Violet", sabor: "Frutas e uva Zero - 473ml", categoria: "Ultra", preco: 10.99, imagem: null, tipoLata: "ultravio", badgeBg: "bg-violet-500/10 text-violet-600 border-violet-500/20" },
            { id: 11, nome: "Monster Fiesta Mango", sabor: "Manga tropical - 473ml", categoria: "Juice", preco: 12.49, imagem: null, tipoLata: "fiesta", badgeBg: "bg-pink-500/10 text-pink-600 border-pink-500/20" },
            { id: 12, nome: "Monster Lewis Hamilton", sabor: "Edição especial - 473ml", categoria: "Original", preco: 12.99, imagem: null, tipoLata: "lewis", badgeBg: "bg-yellow-500/10 text-yellow-700 border-yellow-500/20" }
        ];

        let carrinho = {};
        let abaAtual = 'home';
        let categoriaAtiva = 'todos';
        let cupomDesconto = 0;
        const URL_REGISTRO_VENDAS = "https://script.google.com/macros/s/AKfycbyl7WpUsnzb1aeWNBzOdJDOnXQLElVtX_yWq9Xs4DrGx4UrYaxLE6XPFfLj8nCnstPa/exec";
        let enviandoPedido = false;
        let usuarioAtual = null;
        try { usuarioAtual = JSON.parse(localStorage.getItem('monsterStoreUsuario') || 'null'); } catch (_) { usuarioAtual = null; }

        function mudarAba(aba) {
            abaAtual = aba;
            ['home', 'catalogo', 'perfil', 'login'].forEach(b => {
                const el = document.getElementById(`web-nav-${b}`);
                if (el) {
                    if (b === aba) {
                        el.className = "text-sm font-bold text-emerald-400 transition hover:text-emerald-300 flex items-center space-x-2";
                    } else {
                        el.className = "text-sm font-medium text-slate-400 transition hover:text-white flex items-center space-x-2";
                    }
                }
            });
            const loginLabel = document.getElementById('login-nav-label');
            if (loginLabel) loginLabel.textContent = usuarioAtual ? 'Minha conta' : 'Entrar';
            window.scrollTo({ top: 0, behavior: 'smooth' });
            renderizar();
        }

        function alterarQtd(id, delta) {
            if (!carrinho[id]) {
                if (delta > 0) {
                    const prod = catalogo.find(p => p.id === id);
                    carrinho[id] = { produto: prod, quantidade: delta };
                }
            } else {
                carrinho[id].quantidade += delta;
                if (carrinho[id].quantidade <= 0) {
                    delete carrinho[id];
                }
            }
            atualizarBadge();
            renderizar();
        }

        function atualizarBadge() {
            const totalItens = Object.values(carrinho).reduce((acc, item) => acc + item.quantidade, 0);
            const badge = document.getElementById('cart-badge');
            if (totalItens > 0) {
                badge.innerText = totalItens;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        function calcularTotais() {
            let subtotal = 0;
            for (let item of Object.values(carrinho)) {
                subtotal += item.produto.preco * item.quantidade;
            }
            const descontoVal = subtotal * cupomDesconto;
            const frete = subtotal > 0 ? 10.00 : 0;
            const total = (subtotal - descontoVal) + frete;
            return { subtotal, descontoVal, frete, total };
        }

        function aplicarCupom() {
            const input = document.getElementById('promo-input').value.trim().toUpperCase();
            const msg = document.getElementById('promo-msg');
            if (input === 'MONSTER10' || input === 'BEAST10') {
                cupomDesconto = 0.10;
                msg.innerText = "✅ Cupom de 10% aplicado com sucesso!";
                msg.className = "text-xs text-emerald-400 mt-2 font-medium";
            } else {
                cupomDesconto = 0;
                msg.innerText = "❌ Cupom inválido (Tente: MONSTER10)";
                msg.className = "text-xs text-rose-400 mt-2 font-medium";
            }
            renderizar();
        }

        function renderizar() {
            const main = document.getElementById('main-container');
            main.innerHTML = '';

            if (abaAtual === 'home') {
                const banner = document.createElement('div');
                banner.className = "bg-gradient-to-r from-emerald-900 via-emerald-800 to-slate-900 rounded-3xl p-8 lg:p-12 text-white relative overflow-hidden shadow-2xl flex flex-col md:flex-row justify-between items-center border border-emerald-500/20";
                banner.innerHTML = `
                    <div class="z-10 space-y-4 max-w-xl">
                        <span class="bg-emerald-500/20 text-emerald-300 text-xs font-extrabold px-3.5 py-1.5 rounded-full uppercase tracking-wider border border-emerald-500/30">⚡ Lançamento Oficial</span>
                        <h2 class="text-3xl lg:text-5xl font-black leading-tight tracking-tight">Leve 3, Ganhe 1 Gelado!</h2>
                        <p class="text-sm lg:text-base text-slate-300">Abasteça sua geladeira com os melhores sabores do mercado e garanta energia máxima para o seu dia a dia.</p>
                        <button onclick="mudarAba('catalogo')" class="mt-4 bg-emerald-500 text-slate-950 font-black px-8 py-3.5 rounded-2xl text-sm hover:bg-emerald-400 transition shadow-lg shadow-emerald-500/20 flex items-center space-x-2">
                            <span>Ver Catálogo Completo</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                    <div class="mt-6 md:mt-0 flex justify-center items-center w-48">
                        <img src="data:image/png;base64," alt="Monster Energy" class="h-56 w-full object-contain drop-shadow-2xl" loading="lazy">
                    </div>
                `;
                main.appendChild(banner);

                const catSec = document.createElement('div');
                catSec.className = "mt-12";
                catSec.innerHTML = `
                    <h3 class="text-xl font-black text-white mb-6">Explore por Categoria</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        <button onclick="filtrarCategoria('todos')" class="flex items-center space-x-4 p-5 bg-slate-900 hover:bg-slate-800 rounded-2xl border border-slate-800 hover:border-emerald-500/50 transition shadow-lg group">
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl group-hover:scale-110 transition"><i class="fa-solid fa-bolt"></i></div>
                            <div class="text-left">
                                <span class="block text-sm font-bold text-white">Todos</span>
                                <span class="text-xs text-slate-400">Ver tudo</span>
                            </div>
                        </button>
                        <button onclick="filtrarCategoria('Original')" class="flex items-center space-x-4 p-5 bg-slate-900 hover:bg-slate-800 rounded-2xl border border-slate-800 hover:border-emerald-500/50 transition shadow-lg group">
                            <div class="w-12 h-12 rounded-xl bg-slate-800 text-slate-300 flex items-center justify-center text-xl group-hover:scale-110 transition"><i class="fa-solid fa-fire"></i></div>
                            <div class="text-left">
                                <span class="block text-sm font-bold text-white">Original</span>
                                <span class="text-xs text-slate-400">Tradicionais</span>
                            </div>
                        </button>
                        <button onclick="filtrarCategoria('Ultra')" class="flex items-center space-x-4 p-5 bg-slate-900 hover:bg-slate-800 rounded-2xl border border-slate-800 hover:border-emerald-500/50 transition shadow-lg group">
                            <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-xl group-hover:scale-110 transition"><i class="fa-solid fa-snowflake"></i></div>
                            <div class="text-left">
                                <span class="block text-sm font-bold text-white">Ultra 0%</span>
                                <span class="text-xs text-slate-400">Zero Açúcar</span>
                            </div>
                        </button>
                        <button onclick="filtrarCategoria('Juice')" class="flex items-center space-x-4 p-5 bg-slate-900 hover:bg-slate-800 rounded-2xl border border-slate-800 hover:border-emerald-500/50 transition shadow-lg group">
                            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl group-hover:scale-110 transition"><i class="fa-solid fa-wine-glass"></i></div>
                            <div class="text-left">
                                <span class="block text-sm font-bold text-white">Juice</span>
                                <span class="text-xs text-slate-400">Com Suco</span>
                            </div>
                        </button>
                    </div>
                `;
                main.appendChild(catSec);

                const prodHeader = document.createElement('div');
                prodHeader.className = "flex justify-between items-center mt-12 mb-6";
                prodHeader.innerHTML = `<h3 class="text-xl font-black text-white">Mais Vendidos</h3><button onclick="mudarAba('catalogo')" class="text-sm font-bold text-emerald-400 hover:underline">Ver catálogo completo →</button>`;
                main.appendChild(prodHeader);

                const grid = document.createElement('div');
                grid.className = "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6";
                catalogo.forEach(prod => {
                    grid.appendChild(criarCardProduto(prod));
                });
                main.appendChild(grid);

            } else if (abaAtual === 'catalogo') {
                const headerCat = document.createElement('div');
                headerCat.className = "mb-8";
                headerCat.innerHTML = `
                    <h2 class="text-3xl font-black text-white">Catálogo Monster — 12 sabores</h2>
                    <p class="text-sm text-slate-400 mt-1">Escolha seu sabor favorito e recarregue as energias com os melhores preços do mercado.</p>
                `;
                main.appendChild(headerCat);

                const filtrosDiv = document.createElement('div');
                filtrosDiv.className = "flex space-x-3 mb-8 overflow-x-auto pb-2";
                ['todos', 'Original', 'Ultra', 'Juice'].forEach(cat => {
                    const ativo = categoriaAtiva === cat;
                    filtrosDiv.innerHTML += `
                        <button onclick="filtrarCategoria('${cat}')" class="px-6 py-3 rounded-2xl text-xs font-bold transition whitespace-nowrap ${ativo ? 'bg-emerald-500 text-slate-950 shadow-lg shadow-emerald-500/20' : 'bg-slate-900 text-slate-300 border border-slate-800 hover:border-slate-700'}">
                            ${cat.toUpperCase()}
                        </button>
                    `;
                });
                main.appendChild(filtrosDiv);

                const grid = document.createElement('div');
                grid.className = "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6";
                const filtrados = categoriaAtiva === 'todos' ? catalogo : catalogo.filter(p => p.categoria === categoriaAtiva);
                filtrados.forEach(prod => {
                    grid.appendChild(criarCardProduto(prod));
                });
                main.appendChild(grid);

            } else if (abaAtual === 'carrinho') {
                const itens = Object.values(carrinho);
                
                const topCarrinho = document.createElement('div');
                topCarrinho.className = "flex items-center justify-between mb-8";
                topCarrinho.innerHTML = `
                    <div class="flex items-center space-x-4">
                        <button onclick="mudarAba('home')" class="w-10 h-10 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-300 hover:text-white transition shadow-sm"><i class="fa-solid fa-arrow-left text-sm"></i></button>
                        <h2 class="text-2xl font-black text-white">Carrinho de Compras</h2>
                    </div>
                `;
                main.appendChild(topCarrinho);

                if (itens.length === 0) {
                    main.innerHTML += `
                        <div class="text-center py-24 space-y-4 bg-slate-900/50 rounded-3xl border border-slate-800">
                            <div class="w-20 h-20 bg-emerald-500/10 text-emerald-400 rounded-full flex items-center justify-center mx-auto text-3xl shadow-inner">
                                <i class="fa-solid fa-bag-shopping"></i>
                            </div>
                            <h3 class="font-bold text-white text-lg">Seu carrinho está vazio</h3>
                            <p class="text-xs text-slate-400">Adicione seus sabores favoritos para começar sua compra.</p>
                            <button onclick="mudarAba('catalogo')" class="mt-4 px-8 py-3.5 bg-emerald-500 text-slate-950 font-black rounded-2xl text-xs hover:bg-emerald-400 transition shadow-lg shadow-emerald-500/20">Explorar Produtos</button>
                        </div>
                    `;
                    return;
                }

                const cartGrid = document.createElement('div');
                cartGrid.className = "grid grid-cols-1 lg:grid-cols-3 gap-8";

                const leftCol = document.createElement('div');
                leftCol.className = "lg:col-span-2 space-y-4";
                
                const listaItens = document.createElement('div');
                listaItens.className = "space-y-4";
                itens.forEach(item => {
                    listaItens.innerHTML += `
                        <div class="flex items-center justify-between p-5 bg-slate-900 rounded-2xl border border-slate-800 shadow-sm">
                            <div class="flex items-center space-x-4">
                                <div class="w-16 h-20 bg-slate-950 rounded-xl p-1 flex items-center justify-center border border-slate-800 shrink-0">
                                    <div class="w-10">
                                        <img src="${item.produto.imagem}" alt="${item.produto.nome}" class="h-full w-full object-contain" loading="lazy" onerror="this.style.display='none'">
                                    </div>
                                </div>
                                <div>
                                    <h4 class="font-black text-white text-sm">${item.quantidade}x ${item.produto.nome}</h4>
                                    <p class="text-xs text-slate-400 mb-1">${item.produto.sabor}</p>
                                    <span class="text-xs font-bold text-emerald-400">R$ ${(item.produto.preco * item.quantidade).toFixed(2).replace('.', ',')}</span>
                                </div>
                            </div>
                            <div class="flex items-center space-x-2 bg-slate-950 p-1.5 rounded-xl border border-slate-800">
                                <button onclick="alterarQtd(${item.produto.id}, -1)" class="w-8 h-8 rounded-lg bg-slate-800 text-white flex items-center justify-center font-bold text-xs hover:bg-slate-700 transition"><i class="fa-solid fa-minus text-xs"></i></button>
                                <span class="w-8 text-center text-xs font-bold text-white">${item.quantidade}</span>
                                <button onclick="alterarQtd(${item.produto.id}, 1)" class="w-8 h-8 rounded-lg bg-emerald-500 text-slate-950 flex items-center justify-center font-black text-xs hover:bg-emerald-400 transition"><i class="fa-solid fa-plus text-xs"></i></button>
                            </div>
                        </div>
                    `;
                });
                leftCol.appendChild(listaItens);

                const addMoreBtn = document.createElement('button');
                addMoreBtn.onclick = () => mudarAba('catalogo');
                addMoreBtn.className = "w-full py-4 bg-slate-900 border border-slate-800 text-emerald-400 font-bold rounded-2xl text-xs hover:bg-slate-800 transition shadow-sm flex items-center justify-center space-x-2";
                addMoreBtn.innerHTML = `<i class="fa-solid fa-plus text-xs"></i><span>Adicionar Mais Itens ao Carrinho</span>`;
                leftCol.appendChild(addMoreBtn);

                cartGrid.appendChild(leftCol);

                const rightCol = document.createElement('div');
                rightCol.className = "space-y-6";

                const couponSec = document.createElement('div');
                couponSec.className = "bg-slate-900 p-6 rounded-3xl border border-slate-800 shadow-lg space-y-3";
                couponSec.innerHTML = `
                    <label class="text-xs font-bold text-white block uppercase tracking-wider">Cupom de Desconto</label>
                    <div class="flex space-x-2">
                        <input type="text" id="promo-input" placeholder="Ex: MONSTER10" class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs text-white focus:outline-none focus:border-emerald-500 font-medium">
                        <button onclick="aplicarCupom()" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black px-6 py-3 rounded-xl text-xs transition shadow">Aplicar</button>
                    </div>
                    <div id="promo-msg"></div>
                `;
                rightCol.appendChild(couponSec);

                const { subtotal, descontoVal, frete, total } = calcularTotais();
                const totalsSec = document.createElement('div');
                totalsSec.className = "bg-slate-900 p-6 rounded-3xl border border-slate-800 shadow-lg space-y-4";
                totalsSec.innerHTML = `
                    <h3 class="text-sm font-black text-white uppercase tracking-wider border-b border-slate-800 pb-3">Resumo do Pedido</h3>
                    <div class="flex justify-between text-xs text-slate-400">
                        <span>Subtotal</span>
                        <span class="font-bold text-white">R$ ${subtotal.toFixed(2).replace('.', ',')}</span>
                    </div>
                    ${descontoVal > 0 ? `
                    <div class="flex justify-between text-xs text-emerald-400">
                        <span>Desconto Cupom</span>
                        <span class="font-bold">- R$ ${descontoVal.toFixed(2).replace('.', ',')}</span>
                    </div>` : ''}
                    <div class="flex justify-between text-xs text-slate-400">
                        <span>Frete & Taxas</span>
                        <span class="font-bold text-emerald-400">R$ ${frete.toFixed(2).replace('.', ',')}</span>
                    </div>
                    <div class="border-t border-slate-800 pt-3 flex justify-between text-base font-black text-white">
                        <span>Total Geral</span>
                        <span class="text-emerald-400">R$ ${total.toFixed(2).replace('.', ',')}</span>
                    </div>
                    <button onclick="abrirCheckout()" class="w-full mt-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black py-4 rounded-2xl shadow-xl shadow-emerald-500/30 transition text-sm flex items-center justify-center space-x-2">
                        <span>Ir para o Checkout</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                `;
                rightCol.appendChild(totalsSec);

                cartGrid.appendChild(rightCol);
                main.appendChild(cartGrid);

            } else if (abaAtual === 'perfil') {
                if (!usuarioAtual) { abaAtual = 'login'; renderizar(); return; }
                main.innerHTML = `
                    <div class="max-w-2xl mx-auto py-12">
                        <div class="rounded-[2rem] border border-slate-200 bg-white p-8 sm:p-10 text-center shadow-[0_20px_70px_rgba(15,23,42,.08)]">
                            <div class="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-3xl bg-emerald-500 text-3xl font-black text-slate-950 shadow-lg shadow-emerald-500/20">${usuarioAtual.nome.charAt(0).toUpperCase()}</div>
                            <p class="mb-2 text-xs font-black uppercase tracking-[.25em] text-emerald-600">Área do cliente</p>
                            <h2 class="text-3xl font-black text-slate-900">Olá, ${escaparHTML(usuarioAtual.nome)}.</h2>
                            <p class="mt-2 text-sm text-slate-500">${escaparHTML(usuarioAtual.email)}</p>
                            <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
                                <button onclick="mudarAba('catalogo')" class="rounded-2xl bg-slate-900 px-5 py-4 text-sm font-bold text-white transition hover:bg-slate-800"><i class="fa-solid fa-bolt mr-2 text-emerald-400"></i>Explorar sabores</button>
                                <button onclick="sairDaConta()" class="rounded-2xl border border-slate-200 px-5 py-4 text-sm font-bold text-slate-600 transition hover:bg-slate-50"><i class="fa-solid fa-arrow-right-from-bracket mr-2"></i>Sair da conta</button>
                            </div>
                            <p class="mt-6 text-xs text-amber-700">Modo demonstração: esta sessão fica salva apenas neste navegador. Ainda não é uma autenticação segura com servidor.</p>
                        </div>
                    </div>`;
            } else if (abaAtual === 'login') {
                if (usuarioAtual) { abaAtual = 'perfil'; renderizar(); return; }
                main.innerHTML = `
                    <div class="mx-auto grid max-w-5xl overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_24px_80px_rgba(15,23,42,.10)] md:grid-cols-2">
                        <div class="monster-login-panel relative flex min-h-[300px] flex-col justify-between overflow-hidden p-8 text-white sm:p-10">
                            <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full border-[35px] border-emerald-500/20"></div>
                            <div class="absolute -bottom-20 -left-10 h-64 w-64 rounded-full bg-emerald-500/10 blur-2xl"></div>
                            <div class="relative"><div class="mb-8 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500 text-xl text-slate-950"><i class="fa-solid fa-bolt"></i></div><p class="text-xs font-black uppercase tracking-[.3em] text-emerald-400">Monster Store</p><h2 class="mt-4 text-4xl font-black leading-tight">Sua próxima dose de sabor começa aqui.</h2><p class="mt-4 max-w-sm text-sm leading-6 text-slate-300">Entre para acompanhar sua experiência e descobrir novos sabores.</p></div>
                            <div class="relative mt-10 flex items-center gap-3 text-xs font-semibold text-slate-400"><span class="h-2 w-2 rounded-full bg-emerald-400"></span> Energia para sair do comum.</div>
                        </div>
                        <div class="p-8 sm:p-10">
                            <p class="text-xs font-black uppercase tracking-[.2em] text-emerald-600">Bem-vindo de volta</p><h2 class="mt-2 text-3xl font-black tracking-tight text-slate-900">Acesse sua conta</h2><p class="mt-2 text-sm text-slate-500">Use seu e-mail para entrar ou criar um perfil de demonstração.</p>
                            <form class="mt-8 space-y-5" onsubmit="entrarNaConta(event)">
                                <label class="block"><span class="mb-2 block text-xs font-bold text-slate-700">Nome</span><input id="login-nome" type="text" autocomplete="name" placeholder="Como podemos te chamar?" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10"></label>
                                <label class="block"><span class="mb-2 block text-xs font-bold text-slate-700">E-mail</span><input id="login-email" type="email" required autocomplete="email" placeholder="voce@email.com" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10"></label>
                                <label class="block"><span class="mb-2 block text-xs font-bold text-slate-700">Senha (demonstração)</span><input id="login-senha" type="password" required minlength="4" autocomplete="current-password" placeholder="Mínimo de 4 caracteres" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm text-slate-900 outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10"></label>
                                <p id="login-feedback" class="hidden rounded-xl bg-rose-50 p-3 text-xs font-semibold text-rose-700"></p>
                                <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-2xl bg-emerald-500 px-5 py-4 text-sm font-black text-slate-950 shadow-lg shadow-emerald-500/20 transition hover:bg-emerald-400">Entrar na Monster Store <i class="fa-solid fa-arrow-right"></i></button>
                            </form>
                            <p class="mt-5 text-[11px] leading-5 text-slate-400">Protótipo: a senha é validada apenas no navegador e não é enviada nem salva. Para contas reais, precisaremos configurar autenticação segura no servidor.</p>
                        </div>
                    </div>`;
            }
        }

        function escaparHTML(valor) {
            return String(valor).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        }

        function entrarNaConta(evento) {
            evento.preventDefault();
            const nome = document.getElementById('login-nome').value.trim();
            const email = document.getElementById('login-email').value.trim();
            const senha = document.getElementById('login-senha').value;
            const feedback = document.getElementById('login-feedback');
            if (!email || senha.length < 4) {
                feedback.textContent = 'Informe um e-mail válido e uma senha com pelo menos 4 caracteres.';
                feedback.classList.remove('hidden'); return;
            }
            usuarioAtual = { nome: nome || email.split('@')[0], email };
            localStorage.setItem('monsterStoreUsuario', JSON.stringify(usuarioAtual));
            mudarAba('perfil');
        }

        function sairDaConta() {
            usuarioAtual = null;
            localStorage.removeItem('monsterStoreUsuario');
            mudarAba('login');
        }

        function criarCardProduto(prod) {
            const qtd = carrinho[prod.id] ? carrinho[prod.id].quantidade : 0;
            const card = document.createElement('div');
            card.className = "bg-slate-900 p-5 rounded-3xl border border-slate-800 shadow-xl flex flex-col justify-between hover:border-emerald-500/50 transition duration-300 group";
            card.innerHTML = `
                <div class="w-full h-52 bg-slate-950 rounded-2xl p-4 flex flex-col items-center justify-center relative overflow-hidden border border-slate-800/80 shadow-inner">
                    ${prod.imagem ? `<img src="${prod.imagem}" alt="${prod.nome}" class="h-full w-full object-contain" loading="lazy" onerror="this.style.display='none'">` : `<div class="w-full h-full flex items-center justify-center">${gerarLataSVG(prod.tipoLata || 'green')}</div>`}
                    <span class="absolute top-3 left-3 text-[10px] font-extrabold px-2.5 py-1 rounded-full border ${prod.badgeBg}">${prod.categoria}</span>
                </div>
                <div class="mt-4">
                    <h4 class="font-black text-white text-sm truncate">${prod.nome}</h4>
                    <p class="text-xs text-slate-400 truncate mt-0.5">${prod.sabor}</p>
                    <div class="flex items-center justify-between mt-4">
                        <span class="text-sm font-black text-emerald-400">R$ ${prod.preco.toFixed(2).replace('.', ',')}</span>
                        <div class="flex items-center space-x-2">
                            ${qtd > 0 ? `
                                <button onclick="alterarQtd(${prod.id}, -1)" class="w-8 h-8 rounded-xl bg-slate-800 text-white flex items-center justify-center font-bold text-xs hover:bg-slate-700 transition"><i class="fa-solid fa-minus text-[10px]"></i></button>
                                <span class="w-5 text-center text-xs font-black text-white">${qtd}</span>
                            ` : ''}
                            <button onclick="alterarQtd(${prod.id}, 1)" class="w-9 h-9 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 flex items-center justify-center shadow-lg shadow-emerald-500/25 transition font-black">
                                <i class="fa-solid fa-plus text-xs"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
            return card;
        }

        function filtrarCategoria(cat) {
            categoriaAtiva = cat;
            if (abaAtual !== 'catalogo' && cat !== 'todos') {
                mudarAba('catalogo');
            } else {
                renderizar();
            }
        }

        function abrirCheckout() {
            const { total } = calcularTotais();
            const main = document.getElementById('main-container');
            
            main.innerHTML = `
                <div class="max-w-xl mx-auto space-y-6 py-6 animate-fadeIn">
                    <div class="flex items-center justify-between">
                        <button onclick="mudarAba('carrinho')" class="w-10 h-10 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-300 shadow-sm hover:text-white"><i class="fa-solid fa-arrow-left text-sm"></i></button>
                        <h2 class="text-2xl font-black text-white">Checkout Seguro</h2>
                        <div class="w-10"></div>
                    </div>

                    <div class="bg-emerald-500/10 border border-emerald-500/30 p-4 rounded-2xl text-emerald-300 text-xs flex items-center space-x-3">
                        <i class="fa-solid fa-shield-halved text-2xl text-emerald-400"></i>
                        <div>
                            <span class="font-bold block text-sm">Ambiente Criptografado</span>
                            <span>Selecione sua forma de pagamento preferida abaixo.</span>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <label class="flex items-center p-5 bg-slate-900 border border-slate-800 rounded-2xl cursor-pointer hover:border-emerald-500 transition shadow-sm">
                            <input type="radio" name="pg" value="pix" checked class="text-emerald-500 focus:ring-emerald-500 w-4 h-4">
                            <div class="ml-4 flex items-center justify-between flex-1">
                                <span class="font-black text-sm text-white">Pix (⚡ 5% de Desconto Adicional)</span>
                                <i class="fa-brands fa-pix text-emerald-400 text-xl"></i>
                            </div>
                        </label>
                        <label class="flex items-center p-5 bg-slate-900 border border-slate-800 rounded-2xl cursor-pointer hover:border-emerald-500 transition shadow-sm">
                            <input type="radio" name="pg" value="cartao" class="text-emerald-500 focus:ring-emerald-500 w-4 h-4">
                            <div class="ml-4 flex items-center justify-between flex-1">
                                <span class="font-black text-sm text-white">Cartão de Crédito</span>
                                <i class="fa-solid fa-credit-card text-blue-400 text-xl"></i>
                            </div>
                        </label>
                    </div>

                    <div class="bg-slate-900 p-6 rounded-3xl border border-slate-800 shadow-xl space-y-3">
                        <div class="flex justify-between text-xs text-slate-400">
                            <span>Valor dos Produtos</span>
                            <span class="font-bold text-white">R$ ${total.toFixed(2).replace('.', ',')}</span>
                        </div>
                        <div class="border-t border-slate-800 pt-3 flex justify-between text-base font-black text-white">
                            <span>Total a Pagar</span>
                            <span class="text-emerald-400">R$ ${total.toFixed(2).replace('.', ',')}</span>
                        </div>
                    </div>

                    <button onclick="finalizarSucesso()" class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black py-4 rounded-2xl shadow-xl shadow-emerald-500/30 transition text-sm flex items-center justify-center space-x-2">
                        <span>Confirmar Pagamento e Enviar</span>
                        <i class="fa-solid fa-bolt"></i>
                    </button>
                </div>
            `;
        }

        async function finalizarSucesso() {
            if (enviandoPedido) return;
            if (Object.keys(carrinho).length === 0) {
                alert("Seu carrinho está vazio.");
                return;
            }

            const botao = document.querySelector('#main-container button[onclick="finalizarSucesso()"]');
            const pagamentoSelecionado = document.querySelector('input[name="pg"]:checked');
            const pagamento = pagamentoSelecionado ? pagamentoSelecionado.value : "Não informado";
            const { total } = calcularTotais();
            const pedidoId = "MS-" + Date.now().toString(36).toUpperCase() + "-" + Math.random().toString(36).slice(2, 7).toUpperCase();
            const dadosPedido = {
                pedidoId,
                itens: Object.values(carrinho).map(item => ({
                    produto: item.produto.nome,
                    quantidade: Number(item.quantidade),
                    preco: Number(item.produto.preco)
                })),
                total: Number(total.toFixed(2)),
                pagamento
            };

            enviandoPedido = true;
            if (botao) {
                botao.disabled = true;
                botao.innerHTML = '<span>Registrando pedido...</span><i class="fa-solid fa-spinner fa-spin"></i>';
                botao.classList.add('opacity-60', 'cursor-not-allowed');
            }

            try {
                // Apps Script pode não liberar a leitura da resposta por CORS; no-cors envia o registro sem ler a resposta.
                await fetch(URL_REGISTRO_VENDAS, {
                    method: "POST",
                    mode: "no-cors",
                    headers: { "Content-Type": "text/plain;charset=utf-8" },
                    body: JSON.stringify(dadosPedido)
                });

                carrinho = {};
                cupomDesconto = 0;
                atualizarBadge();
                const main = document.getElementById('main-container');
                main.innerHTML = `
                    <div class="text-center py-24 space-y-6 max-w-xl mx-auto animate-fadeIn">
                        <div class="w-24 h-24 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto text-4xl shadow-inner border border-emerald-500/30 animate-bounce">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <h3 class="text-3xl font-black text-white">Pedido enviado! ⚡</h3>
                        <p class="text-sm text-slate-400 px-6">Pedido <strong>${pedidoId}</strong>. Os dados foram enviados para registro na planilha. A confirmação do pagamento ainda depende da verificação do pagamento.</p>
                        <p class="text-xs text-slate-500">Forma selecionada: ${pagamento === 'pix' ? 'Pix' : pagamento === 'cartao' ? 'Cartão de crédito' : 'Não informada'}</p>
                        <button onclick="mudarAba('home')" class="mt-4 px-8 py-4 bg-slate-900 hover:bg-slate-800 text-white font-black rounded-2xl text-xs transition border border-slate-800 shadow-xl">Voltar à Página Inicial</button>
                    </div>
                `;
            } catch (erro) {
                console.error("Falha ao enviar pedido para a planilha:", erro);
                enviandoPedido = false;
                if (botao) {
                    botao.disabled = false;
                    botao.innerHTML = '<span>Tentar novamente</span><i class="fa-solid fa-bolt"></i>';
                    botao.classList.remove('opacity-60', 'cursor-not-allowed');
                }
                alert("Não foi possível enviar o pedido. Confira sua conexão e tente novamente.");
            }
        }

        renderizar();
    </script>
</body>
</html>
